{
  "name": "rimskifikator",
  "private": true,
  "version": "0.1.19",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "verify:core": "node scripts/python.mjs -m unittest discover -s verification -v",
    "runtime": "node scripts/python.mjs runtime/server.py --data-dir .local-library --port 1421 --dev",
    "package:runtime": "node scripts/python.mjs scripts/package_runtime.py",
    "release:check": "node scripts/python.mjs scripts/check_release.py",
    "desktop:build": "tauri build",
    "release:resources": "node scripts/python.mjs scripts/check_release.py --resources-only",
    "verify:playback": "node --test verification/playback.test.cjs",
    "verify:music": "node --test verification/music.test.cjs",
    "verify:ui": "node --test verification/ui_handlers.test.cjs",
    "verify:player": "node --test verification/player_view.test.cjs",
    "verify:paragraphs": "node --test verification/paragraph_reader.test.cjs",
    "verify:review": "node --test verification/recheck_reader_flow.test.cjs",
    "e2e": "node e2e/guard.mjs && playwright test",
    "e2e:headed": "node e2e/guard.mjs && playwright test --headed",
    "e2e:list": "node e2e/guard.mjs && playwright test --list",
    "e2e:install": "node e2e/guard.mjs && playwright install chromium",
    "e2e:check": "node e2e/guard.mjs && tsc --noEmit -p e2e/tsconfig.json",
    "e2e:guard": "node e2e/guard.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-dialog": "2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.15",
    "hls.js": "1.7.3",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.8.4",
    "@types/node": "24.0.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vite": "6.3.6"
  }
}
